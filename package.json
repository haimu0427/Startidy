{
  "name": "startidy",
  "version": "2.0.0",
  "description": "Contract-driven GitHub Stars organizer for agents and developers",
  "type": "module",
  "bin": {
    "startidy": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "skills",
    "src/schemas"
  ],
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target node --format esm",
    "typegen": "node scripts/generate-types.js",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "start": "bun run src/index.ts",
    "dev": "bun run src/index.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "github",
    "stars",
    "lists",
    "organize",
    "ai",
    "ai-agent",
    "agent-skills",
    "cli",
    "automation"
  ],
  "author": "haimu0427",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haimu0427/Startidy.git"
  },
  "bugs": {
    "url": "https://github.com/haimu0427/Startidy/issues"
  },
  "homepage": "https://github.com/haimu0427/Startidy#readme",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^20.0.0",
    "json-schema-to-typescript": "^16.0.0",
    "typescript": "^5.6.0"
  }
}
